# Python/Flask Hello World .dockerignore
# Excludes unnecessary files from Docker build context to optimize image size and build performance

# Dependencies & Virtual Environments
.venv/
venv/

# Python Bytecode & Caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Version Control
.git
.github
.gitignore

# Documentation
*.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
src/backend/docs

# Testing
src/backend/tests
coverage

# Infrastructure
infrastructure/terraform
infrastructure/docker/docker-compose.yml

# Configuration
.env*

# Logs
*.log

# System Files
.DS_Store
Thumbs.db
